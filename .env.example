# DB API Marketplace (https://developers.deutschebahn.com/) – subscribe the app to OpenBoards (plan "Free").
DB_CLIENT_ID=your_client_id_here
DB_API_KEY=your_api_key_here

# Observed routes as EVA numbers – easiest to maintain with:  dbmon add / dbmon remove
# "<->" = both directions, "->" = one direction, separated by ";". Names in () are only labels.
ROUTES=8001920(Esslingen Neckar)<->8000096(Stuttgart Hbf)

# Example: main line network between major hubs (Hbf = main station), both directions.
# Uncomment and append to ROUTES (separated by ";"). ~15 hubs: ~38,000 requests/day, ~10-15 GB/year of data.
# 8002549(Hamburg Hbf)<->8098160(Berlin Hbf);8002549(Hamburg Hbf)<->8000152(Hannover Hbf);8000152(Hannover Hbf)<->8098160(Berlin Hbf);
# 8000152(Hannover Hbf)<->8000252(Minden Westf);8000252(Minden Westf)<->8000036(Bielefeld Hbf);8000036(Bielefeld Hbf)<->8000080(Dortmund Hbf);
# 8000080(Dortmund Hbf)<->8000085(Düsseldorf Hbf);8000085(Düsseldorf Hbf)<->8000207(Köln Hbf);8000207(Köln Hbf)<->8000105(Frankfurt Main Hbf);
# 8000105(Frankfurt Main Hbf)<->8000244(Mannheim Hbf);8000244(Mannheim Hbf)<->8000096(Stuttgart Hbf);8000096(Stuttgart Hbf)<->8000170(Ulm Hbf);
# 8000170(Ulm Hbf)<->8000261(München Hbf);8000105(Frankfurt Main Hbf)<->8000284(Nürnberg Hbf);8000284(Nürnberg Hbf)<->8000261(München Hbf);
# 8098160(Berlin Hbf)<->8010205(Leipzig Hbf);8010205(Leipzig Hbf)<->8000284(Nürnberg Hbf)

# Optional: extra stations observed on their own (station monitor), e.g. intermediate stops – dbmon add-station
# STATIONS=8006642(Esslingen-Zell)

# Optional
# DB_PATH=./train_db.db     # SQLite file (relative to this file); Docker uses /data/train_db.db
# LIVE_INTERVAL=600         # seconds between live queries (min. 120)
# FINALIZE_AT=03:00         # daily finalization of the previous day (real times, cancellations)
# BACKFILL_DAYS=29          # how many past days are filled in automatically (max. 29)
# GEOCODING=nominatim       # map coordinates via OpenStreetMap Nominatim; "off" disables
